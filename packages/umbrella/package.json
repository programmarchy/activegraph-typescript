{
  "name": "@activegraph/sdk",
  "version": "1.0.5",
  "description": "Active Graph SDK: the default install bundle re-exporting core + runtime + in-memory/SQLite stores + packs + Diligence pack + CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@activegraph/cli": "workspace:^",
    "@activegraph/core": "workspace:^",
    "@activegraph/pack-diligence": "workspace:^",
    "@activegraph/packs": "workspace:^",
    "@activegraph/runtime": "workspace:^",
    "@activegraph/store-memory": "workspace:^",
    "@activegraph/store-sqlite": "workspace:^"
  },
  "license": "Apache-2.0",
  "author": "programmarchy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programmarchy/activegraph-typescript.git",
    "directory": "packages/umbrella"
  },
  "homepage": "https://github.com/programmarchy/activegraph-typescript/tree/main/packages/umbrella#readme",
  "bugs": {
    "url": "https://github.com/programmarchy/activegraph-typescript/issues"
  },
  "keywords": [
    "activegraph",
    "active-graph",
    "event-sourcing",
    "reactive-graph",
    "ai-agents",
    "agentic",
    "auditable",
    "forkable",
    "llm"
  ]
}
